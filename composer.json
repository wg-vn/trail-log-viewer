{
    "name": "wg-vn/trail-log-viewer",
    "description": "Fast and easy-to-use log viewer for your Laravel application",
    "keywords": [
        "wg-vn",
        "laravel",
        "logs",
        "log viewer",
        "better-log-viewer"
    ],
    "homepage": "https://github.com/wg-vn/trail-log-viewer",
    "license": "MIT",
    "authors": [
        {
            "name": "wg-vn",
            "email": "wgarcia@vestednetworks.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^12.0|^13.0",
        "opcodesio/mail-parser": "^0.2.4"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.10|^8.2",
        "itsgoingd/clockwork": "^5.3",
        "laravel/pint": "^1.32",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^4.7|^5.2",
        "pestphp/pest-plugin-laravel": "^4.1|^5.0",
        "spatie/test-time": "^1.3"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required for multi-host support. ^7.10|^8.2"
    },
    "autoload": {
        "psr-4": {
            "WgVn\\TrailLogViewer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WgVn\\TrailLogViewer\\Tests\\": "tests",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "analyse": "echo \"Static analysis not configured yet.\" && exit 0",
        "test": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "vendor/bin/pest --order-by random --no-coverage"
        ],
        "test-coverage": "echo \"Test coverage not configured yet.\" && exit 0",
        "format": "vendor/bin/pint",
        "demo": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WgVn\\TrailLogViewer\\LogViewerServiceProvider"
            ],
            "aliases": {
                "LogViewer": "WgVn\\TrailLogViewer\\Facades\\LogViewer"
            }
        }
    },
    "conflict": {
        "arcanedev/log-viewer": "^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
